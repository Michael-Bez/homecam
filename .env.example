# Copy this to .env and fill in real values. Never commit .env.

# Tailscale IP of the Pi - get with: tailscale ip -4
BIND_IP=100.x.y.z

# Postgres credentials (used by both db and app services)
# letters, numbers, - and _ only (special chars like @ break the DB URL)
DB_USER=homesec
DB_PASSWORD=change-me

# AWS - IAM user pi-surveillance, scoped to this bucket only
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=af-south-1
S3_BUCKET=yourname-pi-security
